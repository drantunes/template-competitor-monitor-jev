# local keeps the native Mastra server loopback-only. production requires a static token and a restart after rotation.
EXECUTION_MODE=local
# MASTRA_API_TOKEN=replace-before-production
# Relative database paths resolve from the project root, outside the disposable build directory.
# MASTRA_DATABASE_URL=file:./.data/mastra.db
# MONITOR_DATABASE_URL=file:./.data/competitor-monitor.db
# MAX_SOURCES=20
# SOURCE_CONCURRENCY=3
# CANDIDATES_PER_SOURCE=20
# JEV_MODEL=jev-latest
