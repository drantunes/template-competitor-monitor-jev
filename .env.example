# local keeps the native Mastra server loopback-only. production requires a static token and a restart after rotation.
EXECUTION_MODE=local
# MASTRA_API_TOKEN=replace-before-production
# Relative database paths resolve from the project root, outside the disposable build directory.
# MASTRA_DATABASE_URL=file:./.data/mastra.db
# MONITOR_DATABASE_URL=file:./.data/competitor-monitor.db
# MAX_SOURCES=20
# SOURCE_CONCURRENCY=3
# CANDIDATES_PER_SOURCE=20
# JEV_MODEL=jev-latest
# Optional supported route. Direct TypeSafe remains the default.
# JEV_ACCESS_MODE=vercel-gateway
# AI_GATEWAY_API_KEY=replace-before-gateway-classification
# Gateway fixes the endpoint and model to https://ai-gateway.vercel.sh/typesafe/v1 and typesafe-ai/jev.
# JEV_COST_ATTESTATION=vercel-ai-gateway-typesafe-2026-09-29:typesafe-ai/jev
# TYPESAFE_AI_API_KEY=replace-before-classification
# Required after the operator verifies the account/model tariff and 64k request bound.
# JEV_COST_ATTESTATION=typesafe-jev-2026-09-27:jev-latest
# JEV_BUDGET_USD=4.50
# Optional grounded summaries use this exact model with reasoning disabled.
# OPENAI_API_KEY=replace-before-summary
# OPENAI_COST_ATTESTATION=openai-gpt-6-luna-2026-09-29:openai/gpt-6-luna
# OPENAI_BUDGET_USD=5.00
# The separate live selector reads F5_LIVE_INPUT_JSON from the shell, not this file.
# It must contain real public pricing, changelog, and documentation sources; the first run may create baselines.
